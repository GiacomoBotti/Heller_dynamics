<Group labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Correlation function for Heller dynamics
restart;
with(LinearAlgebra):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Vectors and Matrices
xvec:=Vector(3,symbol=x):
A:=Matrix(3,3,symbol=a):
r:=Vector(3):
p0:=Vector(3,symbol=P):
q0:=Vector(3,symbol=Q):
r:=xvec-q0;
B:=Matrix(3,3,symbol=b):
s:=Vector(3):
qt:=Vector(3,symbol=q):
pt:=Vector(3,symbol=p):
s:=xvec-qt;

</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Gaussian Matrices
# CAREFUL: HERE G0 IS ALREADY CONJG, SO A IS THE COMPLEX CONJUGATE
G0:=sqrt(Determinant(A)/Pi**3)*exp(-Transpose(r).A.r/2 -I*p0.r);
Gt:=sqrt(Determinant(B)/Pi**3)*exp(-Transpose(s).B.s/2 +I*pt.s);
</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L4" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Correlation
correlation:=int(int(int(G0*Gt,xvec(1)=-infinity..+infinity),xvec(2)=-infinity..+infinity),xvec(3)=-infinity..+infinity);
</Text-field>
</Input>
