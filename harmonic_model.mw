<Group hide-input="false" labelreference="L3" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># WAVEFUNCTION
Q:=Vector(2,symbol=q);
P:=Vector(2,symbol=p);
A:=Matrix(2,2,symbol=a,shape=diagonal);
R:=Vector(2);
R(1):=x-Q(1);
R(2):=y-Q(2);
chi:=simplify(exp(-Transpose(R).A.R + I*P.R +I*gamma)*(Determinant(A)/Pi^2)^(1/4)); 
</Text-field>
</Input>
