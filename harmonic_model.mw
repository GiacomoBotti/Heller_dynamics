<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># POTENTIAL AND DERIVATIVES
with(plots):# Let's take two harmonic oscillators with frequencies 1 and 3
omega1:=1;
omega2:=3;
V:=(omega1*x)^2/2 + (omega2*y)^2/2;
DV:=Vector(2):
DV(1):=diff(V,x):
DV(2):=diff(V,y);
DDV:=Matrix(2,2):
DDV(1,1):=diff(V,x$2):
DDV(1,2):=diff(V,x,y):
DDV(2,1):=DDV(1,2):
DDV(2,2):=diff(V,y$2);</Text-field>
</Input>
