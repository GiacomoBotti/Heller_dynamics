<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># FOURIER TRANSFORM
SqrCorr_data:=getdata(corrplot)[-1]:
Corr_data:=Matrix(500,2):
Corr_data(1..-1,1):=getdata(Replot)[-1][1..-1,1]:
Corr_data(1..-1,2):=getdata(Replot)[-1][1..-1,2] + I*getdata(implot)[-1][1..-1,2]:
data:=Vector(Corr_data[1..-1,2]); #Take the data
F:=FFT(data): #FFT
power := map(x -&gt; abs(x)^2, convert(F, list)): #POWER SPECTRUM
dt:=Corr_data(2,1);
N:= numelems(data):
freq := [seq((k-1)/(N*dt), k=1..N)]:
pointplot(
    [seq([freq[k], abs(F[k])], k=1..N/2)],
    connect=true,
    symbol=cross
);
pts_power := [seq(
    [freq[k], power[k]],
    k=1..iquo(Number,2)
)]:

plot(
    pts_power,
    style=line,
    labels=[&quot;Frequency&quot;,&quot;Power&quot;],
    view=[0..5, DEFAULT]
);</Text-field>
</Input>
