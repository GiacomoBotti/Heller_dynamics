<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># ODE SETUP
#assume(P(1)::real,P(2)::real):
dotQ:=Vector(2):
dotP:=Vector(2):
dotA:=Vector(2):
dotQ(1):=diff(Q(1)(t),t):
dotQ(2):=diff(Q(2)(t),t):
dotP(1):=diff(P(1)(t),t):
dotP(2):=diff(P(2)(t),t):
dotA(1):=diff(A(1,1)(t),t):
dotA(2):=diff(A(2,2)(t),t):
dotgamma:=diff(gamma(t),t):
dotQeq:=Vector(2):
dotPeq:=Vector(2):
dotQeq(1):=P(1)(t):
dotQeq(2):=P(2)(t):
dotPeq(1):=-subs(x=Q(1)(t),DV(1)):
dotPeq(2):=-subs(y=Q(2)(t),DV(2)):
supp_mat:=Matrix(2,2):
supp_mat:=subs([A(1,1)=A(1,1)(t),A(2,2)=A(2,2)(t)],-I*(A.A)+I*DDV):
dotAeq:=Vector(2):
dotAeq(1):=supp_mat(1,1):
dotAeq(2):=supp_mat(2,2):
dotgammaeq:=subs([A(1,1)=A(1,1)(t),A(2,2)=A(2,2)(t),P(1)=P(1)(t),P(2)=P(2)(t),x=Q(1)(t),y=Q(2)(t)],Trace(A)/2 +P.P -V):</Text-field>
</Input>
</Group>
<Group hide-input="false" labelreference="L5" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># EQUATIONS
eqn:=Vector(7):
eqn(1):=dotQ(1)=dotQeq(1):
eqn(2):=dotQ(2)=dotQeq(2):
eqn(3):=dotP(1)=dotPeq(1):
eqn(4):=dotP(2)=dotPeq(2):
eqn(5):=dotA(1)=dotAeq(1):
eqn(6):=dotA(2)=dotAeq(2):
eqn(7):=dotgamma=dotgammaeq;
init:=Vector(7):
init(1):=Q(1)(0)=0:
init(2):=Q(2)(0)=0:
init(3):=P(1)(0)=sqrt(omega1):
init(4):=P(2)(0)=sqrt(omega2):
init(5):=A(1,1)(0)=omega1:
init(6):=A(2,2)(0)=omega2:
init(7):=gamma(0)=subs([A(1,1)=omega1,A(2,2)=omega2],I*ln(omega1*omega2)/4);
eqnset:=convert(eqn,set);
initset:=convert(init,set);
cauchy:=eqnset union initset;</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
