<Group hide-input="false" labelreference="L8" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># GO GO CORRELATION
A0:=Matrix(2,2,shape=diagonal):
A0(1,1):=omega1:
A0(2,2):=omega2:
XY:=Vector(2):
XY(1):=x:
XY(2):=y;
subt:=[A(1,1)=A(1,1)(t),A(2,2)=A(2,2)(t),P(1)=P(1)(t),P(2)=P(2)(t),Q(1)=Q(1)(t),Q(2)=Q(2)(t),gamma=gamma(t)];
sub0:=[A(1,1)=omega1,A(2,2)=omega2,P(1)=1,P(2)=sqrt(3),Q(1)=0,Q(2)=0,gamma=subs([A(1,1)=omega1,A(2,2)=omega2],I*ln(omega1*omega2)/4)];
bvec:=subs(sub0,Transpose(Q).A-I*Transpose(P)) + subs(subt,Transpose(Q).A+I*Transpose(P));
c:=subs(sub0,-Transpose(Q).A.Q +I*P.Q) + subs(subt,-Transpose(Q).A.Q -I*P.Q);
N0:=subs(sub0,(Determinant(A)/Pi^2)^(1/4));
Nt:=subs(subt,(Determinant(A)/Pi^2)^(1/4));
NG:=sqrt(4*Pi^2/Determinant(subs(sub0,A)+subs(subt,A)));
integrand:=N0*Nt*exp(-0.5*Transpose(XY).(subs(sub0,A)+subs(subt,A)).XY+bvec.XY+c);
#wfn0:=subs(I=-I,subs(sub0,chi));
#wfnt:=subs(subt,chi);
Ainv:=MatrixInverse(subs(sub0,A)+subs(subt,A));
integral:=NG*N0*Nt*exp(0.5*bvec.Ainv.Transpose(bvec)+c);
#integrand_anal:=wfn0*wfnt;
#check:=((integrand_anal-integrand));
evalf(subs(dsols(0),integral));
corrplot:=odeplot(dsols,{[t,abs(integral)^2]},t=0..10,labels=['t',&quot;|C(t)|^2&quot;],numpoints=500); # C(t) vs t
Replot:=odeplot(dsols,{[t,Re(integral)]},numpoints=500);
implot:=odeplot(dsols,{[t,Im(integral)]},numpoints=500);
</Text-field>
</Input>
